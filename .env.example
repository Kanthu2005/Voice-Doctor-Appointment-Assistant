# ===========================================
# Voice AI Doctor Appointment Assistant
# Copy this file to .env (or backend/.env & frontend/.env)
# ===========================================

# --- Backend Server ---
APP_NAME=Voice AI Doctor Appointment Assistant
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./data/appointments.db

# --- AI & Voice Providers ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
